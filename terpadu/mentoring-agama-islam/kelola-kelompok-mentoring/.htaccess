# URL Rewrite: Clean URLs & Force Clean URLs
RewriteEngine On

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# PWA: MIME type manifest & header Service Worker
AddType application/manifest+json .webmanifest
<FilesMatch "^sw\.js$">
    <IfModule mod_headers.c>
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </IfModule>
</FilesMatch>

# 1. Jika pengguna mengakses URL yang secara eksplisit mengetikkan /index.php atau /index, redirect 301 ke direktori /
RewriteCond %{THE_REQUEST} \s/+(.+/)?index\.php[?\s] [OR]
RewriteCond %{THE_REQUEST} \s/+(.+/)?index[?\s]
RewriteRule ^(.+/)?index(?:\.php)?$ $1 [R=301,L]

# 2. Jika pengguna tidak sengaja mengetik ekstensi .php pada URL apa pun, redirect 301 ke URL bersih tanpa .php
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^(.+?)\.php$ $1 [R=301,L]

# 3. Routing internal: arahkan URL bersih ke file .php di belakang layar
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f [OR]
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]
