RewriteEngine On

# ── Domain kanonis: ukmipolmed.my.id ──
# Redirect semua trafik ukmipolmed.xo.je (dengan www atau tidak) ke https://ukmipolmed.my.id
RewriteCond %{HTTP_HOST} ^(www\.)?ukmipolmed\.xo\.je$ [NC]
RewriteRule ^ https://ukmipolmed.my.id%{REQUEST_URI} [L,R=301]

# ── Force HTTPS ──
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:CF-Visitor} !{"scheme":"https"}
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Home: /index dan /index.php -> / ──
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^index/?$ / [R=301,L]

# ── Blog pretty URLs ──
RewriteRule ^blog/arsip/?$ blog.php?arsip=1 [L,QSA]
RewriteRule ^blog/([^/]+)/?$ blog.php?slug=$1 [L,QSA]

# Redirect legacy query-string blog URLs to pretty URLs
RewriteCond %{THE_REQUEST} \s/+blog\.php\?arsip=1\b [NC]
RewriteRule ^ /blog/arsip? [R=301,L]
RewriteCond %{THE_REQUEST} \s/+blog\.php\?slug=([^\s&]+) [NC]
RewriteRule ^ /blog/%1? [R=301,L]

# Sitemap dinamis: /sitemap.xml dilayani oleh sitemap.php (canonical XML)
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteCond %{THE_REQUEST} \s/+sitemap\.php[\s?] [NC]
RewriteRule ^ /sitemap.xml [R=301,L]

# Admin pretty URL
RewriteRule ^admin/?$ admin.php [L,QSA]
RewriteCond %{THE_REQUEST} \s/+admin\.php[\s?] [NC]
RewriteCond %{REQUEST_METHOD} =GET
RewriteRule ^ /admin [R=301,L]

# Alias login (akun berbasis peran: admin & penulis)
RewriteRule ^login/?$ admin.php [L,QSA]

# Panel penulis
RewriteRule ^menulis/?$ penulis-panel.php [L,QSA]

# Halaman asesmen (pretest/posttest)
RewriteRule ^asesmen/?$ asesmen.php [L,QSA]

# Profil penulis
RewriteRule ^penulis/?$ penulis.php?u=admin [L,QSA]
RewriteRule ^penulis/([^/]+)/?$ penulis.php?u=$1 [L,QSA]

# ── Hilangkan ekstensi .php di semua URL ──
# Komponen PHP internal hanya di-include server-side, bukan entry point web.
RewriteRule ^components/.*\.php$ - [R=404,L]
RewriteCond %{REQUEST_URI} ^/components/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^components/.*$ - [R=404,L]

# Library internal bukan entry point web; tolak akses langsung.
RewriteRule ^(store|data_store|assessments_store|s3_helper|s3_gc_helper|hosting_storage_helper|seo_cache|seo_corrector_helper|maintenance_guard|security_helper|authors_helper|assessments_helper|shortcut_migration)(?:\.php)?/?$ - [R=404,L]

# 1) Permintaan GET langsung ke *.php dialihkan permanen ke URL tanpa ekstensi.
# Hanya GET: redirect 301 mengubah POST menjadi GET dan menghilangkan body form.
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.php(?:[\s?]|$) [NC]
RewriteRule ^ /%1 [R=301,L]

# 2) URL tanpa ekstensi dipetakan internal ke file .php yang sesuai
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# ── Security Headers ──
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Cache static assets (Core Web Vitals / PageSpeed) ──
# Aset statis cukup di-cache browser; tidak perlu menyentuh S3/hosting lagi.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType font/woff2 "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpe?g|gif|webp|svg|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# ── Gzip Compression ──
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/xml application/xml image/svg+xml
</IfModule>

# ── Custom 404 ──

# Block write/modify verbs to any JSON (hardens against PUT/POST/etc.)
<FilesMatch "\.json$">
    <LimitExcept GET HEAD OPTIONS>
        Require all denied
    </LimitExcept>
</FilesMatch>

# Fully deny sensitive stores from the web (cannot be read or written)
<FilesMatch "^(insights|data)\.json$">
    Require all denied
</FilesMatch>

# default.json contains admin credentials — deny ALL web access
<Files "default.json">
    Require all denied
</Files>

# authors.json berisi hash password akun penulis — deny akses web
<Files "authors.json">
    Require all denied
</Files>

# assessments.json berisi kunci jawaban + data responden — deny akses web
<Files "assessments.json">
    Require all denied
</Files>

# s3_config.php berisi kredensial S3 — deny akses web
<Files "s3_config.php">
    Require all denied
</Files>

# .s3_usage.json — cache angka pemakaian S3, jangan diekspos
<Files ".s3_usage.json">
    Require all denied
</Files>

# .s3_uploads.json — cache pemakaian folder uploads S3, jangan diekspos
<Files ".s3_uploads.json">
    Require all denied
</Files>

# .hosting_usage.json — cache scan pemakaian storage hosting, jangan diekspos
<Files ".hosting_usage.json">
    Require all denied
</Files>

# Block access to cache, backup, dotfiles, and internal docs/scripts
RedirectMatch 404 /\.backups(/|$)
RedirectMatch 404 /\.store(/|$)
RedirectMatch 404 /seo-cache(/|$)
RedirectMatch 404 /(?!\.well-known(?:/|$))\.
<FilesMatch "(?i)^(AGENTS\.md|TEMUAN\.txt|readme\.md|router\.php)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.sh$">
    Require all denied
</FilesMatch>

# Legacy Apache 2.2 fallback
<IfModule mod_access_compat.c>
    <FilesMatch "^(insights|data)\.json$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <Files "default.json">
        Order allow,deny
        Deny from all
    </Files>
    <Files ".hosting_usage.json">
        Order allow,deny
        Deny from all
    </Files>
    <FilesMatch "\.json$">
        <LimitExcept GET HEAD OPTIONS>
            Order allow,deny
            Deny from all
        </LimitExcept>
    </FilesMatch>
</IfModule>

# BEGIN InfinityFree Managed Code
# DO NOT EDIT - MANAGED BY THE MEMBERS AREA
php_value date.timezone Asia/Jakarta
ErrorDocument 400 https://ukmipolmed.my.id/error.php?code=Salah%20minta%20nih%20(400)
ErrorDocument 401 https://ukmipolmed.my.id/error.php?code=Kita%20ga%20punya%20izin%20bre%20(401)
ErrorDocument 403 https://ukmipolmed.my.id/error.php?code=Waduh%20ga%20boleh%20masuk%20(403)
ErrorDocument 404 https://ukmipolmed.my.id/error.php?code=Apekah%20tak%20de%20siape%20siape%20(404)
ErrorDocument 500 https://ukmipolmed.my.id/error.php?code=Tidak.%20Rumah%20gweh%20(500)
ErrorDocument 503 https://ukmipolmed.my.id/error.php?code=Loh%2C%20tadi%20rumah%20saya%20disini%20(503)
# END InfinityFree Managed Code
